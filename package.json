    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@yesprasoon/capacitor-bluetooth-communication": "^1.0.0",
    "capacitor-usb-serial": "github:LeeSkies/capacitor-usb-serial",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.5.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
